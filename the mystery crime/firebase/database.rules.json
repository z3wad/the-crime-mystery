{
  "rules": {
    ".read": false,
    ".write": false,
    "leaderboard": {
      ".read": true,
      ".write": true,
      "$id": {
        ".validate": "newData.hasChildren(['name','correct','score','time','rank','ts'])",
        "name":    { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
        "correct": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20" },
        "score":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
        "time":    { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "rank":    { ".validate": "newData.isString() && newData.val().length <= 2" },
        "pick":    { ".validate": "newData.isString() && newData.val().length <= 20" },
        "ok":      { ".validate": "newData.isBoolean()" },
        "ts":      { ".validate": "newData.isNumber()" },
        "$other":  { ".validate": false }
      }
    }
  }
}
